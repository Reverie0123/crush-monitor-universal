{
  "name": "crush-monitor-universal",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "build:demo": "vite build --mode demo --base ./ --outDir dist-demo",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check:live": "tsx scripts/check-live.ts",
    "setup": "node scripts/setup.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "dotenv": "^16.4.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "prettier": "^3.9.8",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "license": "MIT",
  "description": "Local-first WeChat-style conversation analysis with your own API key for any OpenAI-compatible model (adapted from the original Jev-based Crush Monitor)",
  "engines": {
    "node": ">=22.12.0"
  }
}
