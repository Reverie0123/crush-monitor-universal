# 以下都可以在网页「设置 → 模型与接口」里修改，不必手动编辑本文件。

# 用哪个模型分析：openai（DeepSeek / OpenAI 等兼容接口，默认）或 jev（原版的 TypeSafe Jev）
LLM_PROVIDER=openai
# 选 jev 时：调用平台 openrouter / vercel / typesafe，以及各平台自己的 Key
JEV_PLATFORM=openrouter
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=
TYPESAFE_API_KEY=
# 选 jev 时，回复建议是否用下面的 DeepSeek / OpenAI 来写（on / off，off 即「仅 Jev」）
JEV_SUGGEST=off

# 你的 API Key（DeepSeek：https://platform.deepseek.com/api_keys）
OPENAI_API_KEY=
# 模型名：deepseek-chat（快、便宜）或 deepseek-reasoner（更慢，推理更强）
OPENAI_MODEL=deepseek-chat
# 推理强度：DeepSeek 不支持，留空；换成 OpenAI 的 GPT-5 系列时可填 low
OPENAI_REASONING_EFFORT=
# 随机度，留空用模型默认；越低结果越稳定
OPENAI_TEMPERATURE=
# 接口地址：DeepSeek；换成 OpenAI 时改成 https://api.openai.com/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1
# 发送前自动打码手机号、邮箱、身份证号、银行卡号（on / off）
PRIVACY_MASK=on
# 额外打码的词，逗号分隔（真名、学校、地址等）
MASK_WORDS=
# 缓存模型回复，同样的内容再分析时不重复花钱（on / off）
LLM_CACHE=on
PORT=3178
HOST=127.0.0.1
